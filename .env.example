# NYC PolicyScope Lab — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ─── Claude / Anthropic ──────────────────────────────────────────────────────
# Required by nanoclaw (the manager agent)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Google AI Studio (Imagen 2 image generation) ────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
# Used by scripts/generate_image.py and the n8n image generation workflow.
# Images returned via API are raw PNG — no visible Gemini logo.
GOOGLE_AI_API_KEY=your_google_ai_studio_api_key_here

# Imagen model to use (do not change unless Google releases a newer version)
IMAGEN_MODEL=imagen-3.0-generate-002

# ─── GoHighLevel (GHL) ───────────────────────────────────────────────────────
# Your GHL private integration API key
# Settings → Integrations → API Keys in your GHL account
GHL_API_KEY=your_ghl_api_key_here

# Your GHL Location ID (sub-account) — found in the GHL URL or API response
GHL_LOCATION_ID=your_ghl_location_id_here

# GHL API base URL (do not change)
GHL_API_BASE=https://services.leadconnectorhq.com

# ─── Discord (nanoclaw channel) ──────────────────────────────────────────────
# Create a bot at: https://discord.com/developers/applications
# Add the bot to your server with: Send Messages, Read Message History permissions
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# The Discord channel ID where nanoclaw listens (right-click channel → Copy ID)
DISCORD_CHANNEL_ID=your_discord_channel_id_here

# The trigger word nanoclaw responds to (default: @Andy in nanoclaw, override here)
NANOCLAW_TRIGGER=@policy

# ─── n8n ─────────────────────────────────────────────────────────────────────
# Used by nanoclaw to trigger n8n workflows via webhook
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_TOKEN=your_n8n_webhook_secret_here

# n8n basic auth (matches docker/docker-compose.yml)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=nycpolicy2026
