{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "newsletter-blocks",
  "title": "NYC PolicyScope Newsletter Blocks",
  "description": "Block-based content model. Each newsletter is composed of an ordered list of typed blocks. This schema replaces the single-structure newsletter.json for new pipelines. newsletter.json is preserved for backward compatibility.",
  "type": "object",
  "required": ["meta", "blocks"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "description": "Newsletter-level metadata. Not rendered as a block.",
      "required": ["subject_line", "preview_text"],
      "additionalProperties": false,
      "properties": {
        "subject_line": {
          "type": "string",
          "minLength": 10,
          "maxLength": 80,
          "description": "Email subject line. Clear and specific. No clickbait."
        },
        "preview_text": {
          "type": "string",
          "minLength": 20,
          "maxLength": 140,
          "description": "Preview text shown in inbox after subject."
        },
        "edition": {
          "type": "string",
          "description": "Edition label, e.g. Vol. 1, No. 1"
        },
        "week_of": {
          "type": "string",
          "description": "ISO date for this edition's week, e.g. 2026-03-16"
        },
        "template": {
          "type": "string",
          "default": "newsletter",
          "description": "Template filename (without .html) to use for rendering. Enables multi-template support."
        }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered list of content blocks. Rendered in sequence by the template. Block types: hero, news_item, insight, feature, tips, cta, links, event.",
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/hero_block" },
          { "$ref": "#/definitions/news_item_block" },
          { "$ref": "#/definitions/insight_block" },
          { "$ref": "#/definitions/feature_block" },
          { "$ref": "#/definitions/tips_block" },
          { "$ref": "#/definitions/cta_block" },
          { "$ref": "#/definitions/links_block" },
          { "$ref": "#/definitions/event_block" }
        ]
      }
    }
  },
  "definitions": {
    "hero_block": {
      "type": "object",
      "description": "Optional custom header block. When omitted the template header is used.",
      "required": ["type", "title"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "hero" },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "subtitle": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "news_item_block": {
      "type": "object",
      "description": "A single borough-level news update. Multiple news_item blocks are grouped into the NYC Quick Updates section.",
      "required": ["type", "borough", "body"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "news_item" },
        "borough": {
          "type": "string",
          "enum": ["Manhattan", "Brooklyn", "Queens", "Bronx", "Staten Island", "Citywide"],
          "description": "NYC borough or Citywide for cross-borough stories."
        },
        "body": {
          "type": "string",
          "minLength": 30,
          "maxLength": 400,
          "description": "1-3 sentences. Factual, local, no hype."
        }
      }
    },
    "insight_block": {
      "type": "object",
      "description": "A single editorial insight section. One per newsletter typical.",
      "required": ["type", "body"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "insight" },
        "body": {
          "type": "string",
          "minLength": 50,
          "maxLength": 600,
          "description": "1-2 paragraphs connecting weekly themes."
        }
      }
    },
    "feature_block": {
      "type": "object",
      "description": "Deep-dive feature article. One per newsletter typical.",
      "required": ["type", "title", "body"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "feature" },
        "title": {
          "type": "string",
          "minLength": 5,
          "maxLength": 100
        },
        "body": {
          "type": "string",
          "minLength": 100,
          "maxLength": 1200,
          "description": "2-4 paragraphs. Substantive, local policy focus."
        }
      }
    },
    "tips_block": {
      "type": "object",
      "description": "Quick tips and resources. One block contains the full list.",
      "required": ["type", "items"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "tips" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 10,
            "maxLength": 200,
            "description": "Short actionable item: link, deadline, or resource."
          }
        }
      }
    },
    "cta_block": {
      "type": "object",
      "description": "Soft call-to-action. Community-oriented, no hard sales.",
      "required": ["type", "body"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "cta" },
        "body": {
          "type": "string",
          "minLength": 20,
          "maxLength": 300
        }
      }
    },
    "links_block": {
      "type": "object",
      "description": "Optional curated links section for resources or further reading.",
      "required": ["type", "items"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "links" },
        "title": {
          "type": "string",
          "maxLength": 100
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["label", "url"],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 2,
                "maxLength": 100
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "description": {
                "type": "string",
                "maxLength": 200
              }
            }
          }
        }
      }
    },
    "event_block": {
      "type": "object",
      "description": "Optional upcoming event block.",
      "required": ["type", "title", "date"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "event" },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "date": {
          "type": "string",
          "description": "Human-readable date string, e.g. Thursday, March 27"
        },
        "location": {
          "type": "string",
          "maxLength": 200
        },
        "body": {
          "type": "string",
          "maxLength": 500
        }
      }
    }
  }
}
